# =============================================================================
# SupportFlow Backend Automation Service — Environment Configuration (.env.example)
# Copy this file to `backend/.env` and replace placeholder values before running.
# =============================================================================

# --- Supabase Project Credentials (Required) ---
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- Webhook Security (Required) ---
# Must match `ticket_created_webhook_secret` in public.webhook_config
WEBHOOK_SECRET=replace_with_strong_random_webhook_secret

# --- Frontend Deep-Link Base URL ---
FRONTEND_BASE_URL=http://localhost:5173

# --- Slack Incoming Webhook Alerting (Optional — dry-runs if blank) ---
SLACK_WEBHOOK_URL=

# --- SMTP Email Alerting (Optional — dry-runs if SMTP_HOST is blank) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@supportflow.local
SMTP_USE_TLS=true

# --- Background Worker Intervals & Retry Tuning ---
SLA_POLL_INTERVAL_SECONDS=60
SLA_WARNING_WINDOW_MINUTES=30
RETRY_POLL_INTERVAL_SECONDS=30
RETRY_BASE_BACKOFF_SECONDS=30
RETRY_MAX_BACKOFF_SECONDS=3600
RETRY_MAX_ATTEMPTS=5